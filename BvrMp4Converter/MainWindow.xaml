<Window x:Class="BvrMp4Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BVR → MP4 Converter" Height="780" Width="960" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drag & drop zóna -->
        <Border x:Name="DropZone" Grid.Row="0" Height="100" AllowDrop="True" CornerRadius="8"
                BorderBrush="#FF6A8CAF" BorderThickness="2" Background="#FFF2F6FA"
                Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="#FF45637F"
                       TextAlignment="Center" IsHitTestVisible="False">
                Húzd ide a .bvr fájlokat vagy mappákat<LineBreak/>
                <Run FontSize="12">(mappánál az összes .bvr rekurzívan)</Run>
            </TextBlock>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="BrowseFilesBtn" Content="Tallózás…" Padding="14,4" Click="BrowseFiles_Click"/>
            <Button x:Name="RemoveSelBtn" Content="Kijelöltek törlése" Padding="10,4" Margin="8,0,0,0" Click="RemoveSelected_Click"/>
            <Button x:Name="ClearBtn" Content="Lista ürítése" Padding="10,4" Margin="8,0,0,0" Click="Clear_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Fájllista -->
        <ListView x:Name="FileList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged"
                  KeyDown="FileList_KeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Név" Width="260" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Méret" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="Állapot" Width="95" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="Haladás" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Height="16" Width="135"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding Indeterminate}"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Megjegyzés" Width="300" DisplayMemberBinding="{Binding Note}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Hiba / ffmpeg kimenet -->
        <GroupBox Grid.Row="3" Header="ffmpeg kimenet / hiba (a kijelölt fájlhoz)" Margin="0,8,0,0">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Beállítások -->
        <GroupBox Grid.Row="4" Header="Beállítások" Margin="0,8,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <RadioButton x:Name="RemuxRadio" GroupName="mode" Content="Gyors 1:1 (remux)" Checked="Option_Changed"/>
                    <RadioButton x:Name="ReencodeRadio" GroupName="mode" Content="Újrakódolás hardveresen" Margin="0,4,0,0" Checked="Option_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                        <TextBlock Text="Kodek:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CodecCombo" Width="90" Margin="6,0,0,0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="H.264" Tag="h264"/>
                            <ComboBoxItem Content="H.265" Tag="hevc"/>
                        </ComboBox>
                        <TextBlock x:Name="EncoderText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                        <TextBlock Text="Minőség (CRF/CQ):" VerticalAlignment="Center"/>
                        <Slider x:Name="QualitySlider" Minimum="15" Maximum="35" Width="140" Margin="6,0,0,0"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged"/>
                        <TextBlock x:Name="QualityText" Width="24" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="(kisebb = jobb)" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="HalfResCheck" Content="Felbontás felezése" Margin="20,6,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="RotateCheck" Content="Forgatás 180° (újrakódolást igényel)" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="DeleteCheck" Content="Sikeres konvertálás után az eredeti .bvr törlése" Margin="0,6,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Párhuzamos feldolgozás:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ParallelCombo" Width="50" Margin="6,0,0,0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                        </ComboBox>
                        <TextBlock Text="fájl egyszerre" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Ha a kimeneti fájl már létezik:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PolicyCombo" Width="110" Margin="6,0,0,0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="Kérdezzen" Tag="Ask"/>
                            <ComboBoxItem Content="Felülír" Tag="Overwrite"/>
                            <ComboBoxItem Content="Kihagy" Tag="Skip"/>
                            <ComboBoxItem Content="Átnevez" Tag="Rename"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Kimeneti mappa -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Kimeneti mappa:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" VerticalContentAlignment="Center" Padding="2,4"
                     ToolTip="Üresen hagyva a konvertált fájl az eredeti mellé kerül." TextChanged="Option_Changed"/>
            <Button Grid.Column="2" Content="Tallózás…" Padding="12,4" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
            <Button Grid.Column="3" Content="Mappa megnyitása" Padding="12,4" Margin="8,0,0,0" Click="OpenOutput_Click"/>
        </Grid>

        <!-- Vezérlés -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartBtn" Content="Start" Width="100" Padding="0,6" FontWeight="Bold" Click="Start_Click"/>
            <Button x:Name="StopBtn" Grid.Column="1" Content="Leállítás" Width="100" Padding="0,6" Margin="8,0,0,0"
                    IsEnabled="False" Click="Stop_Click"/>
            <ProgressBar x:Name="TotalBar" Grid.Column="2" Height="22" Margin="12,0" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="TotalText" Grid.Column="3" VerticalAlignment="Center" MinWidth="230" Text="—"/>
        </Grid>
    </Grid>
</Window>
