<Window x:Class="BvrMp4Converter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BvrMp4Converter"
        Title="BVR → MP4 Converter" Height="780" Width="960" MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterScreen" Icon="{StaticResource AppLogo}">
    <DockPanel>
    <Menu DockPanel.Dock="Top">
        <MenuItem Header="{local:Tr menu_lang}">
            <MenuItem x:Name="LangEn" Header="{local:Tr lang_en}" Tag="en" IsCheckable="True" Click="Lang_Click"/>
            <MenuItem x:Name="LangHu" Header="{local:Tr lang_hu}" Tag="hu" IsCheckable="True" Click="Lang_Click"/>
        </MenuItem>
        <MenuItem Header="{local:Tr menu_about}" Click="About_Click"/>
    </Menu>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drag & drop zóna -->
        <Border x:Name="DropZone" Grid.Row="0" Height="100" AllowDrop="True" CornerRadius="8"
                BorderBrush="#FF6A8CAF" BorderThickness="2" Background="#FFF2F6FA"
                Drop="DropZone_Drop" DragEnter="DropZone_DragEnter" DragLeave="DropZone_DragLeave">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="{local:Tr drop_main}" FontSize="18" Foreground="#FF45637F" TextAlignment="Center"/>
                <TextBlock Text="{local:Tr drop_sub}" FontSize="12" Foreground="#FF45637F" TextAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="BrowseFilesBtn" Content="{local:Tr btn_browse}" Padding="14,4" Click="BrowseFiles_Click"/>
            <Button x:Name="RemoveSelBtn" Content="{local:Tr btn_remove_sel}" Padding="10,4" Margin="8,0,0,0" Click="RemoveSelected_Click"/>
            <Button x:Name="ClearBtn" Content="{local:Tr btn_clear}" Padding="10,4" Margin="8,0,0,0" Click="Clear_Click"/>
            <TextBlock x:Name="CountText" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- Fájllista -->
        <ListView x:Name="FileList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged"
                  KeyDown="FileList_KeyDown">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="{local:Tr col_name}" Width="260" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="{local:Tr col_size}" Width="80" DisplayMemberBinding="{Binding SizeText}"/>
                    <GridViewColumn Header="{local:Tr col_status}" Width="95" DisplayMemberBinding="{Binding StatusText}"/>
                    <GridViewColumn Header="{local:Tr col_progress}" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ProgressBar Minimum="0" Maximum="100" Height="16" Width="135"
                                                 Value="{Binding Progress, Mode=OneWay}"
                                                 IsIndeterminate="{Binding Indeterminate}"/>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="{local:Tr col_note}" Width="300" DisplayMemberBinding="{Binding Note}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Hiba / ffmpeg kimenet -->
        <GroupBox Grid.Row="3" Header="{local:Tr grp_details}" Margin="0,8,0,0">
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </GroupBox>

        <!-- Beállítások -->
        <GroupBox Grid.Row="4" Header="{local:Tr grp_settings}" Margin="0,8,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <RadioButton x:Name="RemuxRadio" GroupName="mode" Content="{local:Tr mode_remux}" Checked="Option_Changed"/>
                    <RadioButton x:Name="ReencodeRadio" GroupName="mode" Content="{local:Tr mode_reencode}" Margin="0,4,0,0" Checked="Option_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                        <TextBlock Text="{local:Tr lbl_codec}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CodecCombo" Width="90" Margin="6,0,0,0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="H.264" Tag="h264"/>
                            <ComboBoxItem Content="H.265" Tag="hevc"/>
                        </ComboBox>
                        <TextBlock x:Name="EncoderText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                        <TextBlock Text="{local:Tr lbl_quality}" VerticalAlignment="Center"/>
                        <Slider x:Name="QualitySlider" Minimum="15" Maximum="35" Width="140" Margin="6,0,0,0"
                                TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged"/>
                        <TextBlock x:Name="QualityText" Width="24" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{local:Tr hint_quality}" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox x:Name="HalfResCheck" Content="{local:Tr chk_half}" Margin="20,6,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <CheckBox x:Name="RotateCheck" Content="{local:Tr chk_rotate}" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="DeleteCheck" Content="{local:Tr chk_delete}" Margin="0,6,0,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{local:Tr lbl_parallel}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ParallelCombo" Width="50" Margin="6,0,0,0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                        </ComboBox>
                        <TextBlock Text="{local:Tr lbl_parallel_unit}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{local:Tr lbl_policy}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="PolicyCombo" Width="110" Margin="6,0,0,0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="{local:Tr pol_ask}" Tag="Ask"/>
                            <ComboBoxItem Content="{local:Tr pol_overwrite}" Tag="Overwrite"/>
                            <ComboBoxItem Content="{local:Tr pol_skip}" Tag="Skip"/>
                            <ComboBoxItem Content="{local:Tr pol_rename}" Tag="Rename"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Kimeneti mappa -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{local:Tr lbl_output}" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="OutputBox" Grid.Column="1" VerticalContentAlignment="Center" Padding="2,4"
                     ToolTip="{local:Tr tip_output}" TextChanged="Option_Changed"/>
            <Button Grid.Column="2" Content="{local:Tr btn_browse}" Padding="12,4" Margin="8,0,0,0" Click="BrowseOutput_Click"/>
            <Button Grid.Column="3" Content="{local:Tr btn_open_output}" Padding="12,4" Margin="8,0,0,0" Click="OpenOutput_Click"/>
        </Grid>

        <!-- Vezérlés -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="StartBtn" Content="{local:Tr btn_start}" Width="100" Padding="0,6" FontWeight="Bold" Click="Start_Click"/>
            <Button x:Name="StopBtn" Grid.Column="1" Content="{local:Tr btn_stop}" Width="100" Padding="0,6" Margin="8,0,0,0"
                    IsEnabled="False" Click="Stop_Click"/>
            <ProgressBar x:Name="TotalBar" Grid.Column="2" Height="22" Margin="12,0" Minimum="0" Maximum="100"/>
            <TextBlock x:Name="TotalText" Grid.Column="3" VerticalAlignment="Center" MinWidth="230" Text="—"/>
        </Grid>
    </Grid>
    </DockPanel>
</Window>
