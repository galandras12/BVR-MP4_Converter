<Window x:Class="BvrMp4Converter.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:BvrMp4Converter"
        Title="{local:Tr about_title}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="{StaticResource AppLogo}">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Source="{StaticResource AppLogo}" Width="96" Height="96" VerticalAlignment="Top" Margin="0,0,20,0"/>

        <StackPanel Grid.Column="1">
            <TextBlock Text="BVR → MP4 Converter" FontSize="22" FontWeight="Bold"/>
            <TextBlock x:Name="VersionText" Foreground="Gray" Margin="0,2,0,14"/>

            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run FontWeight="SemiBold" Text="{local:Tr about_dev}"/>
                <Run Text="Galandras12"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run FontWeight="SemiBold" Text="{local:Tr about_sw}"/>
                <Run Text="Claude Sonnet 5.5"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run FontWeight="SemiBold" Text="{local:Tr about_src}"/>
                <Hyperlink NavigateUri="https://github.com/galandras12/BVR-MP4_Converter" RequestNavigate="Link_Navigate">https://github.com/galandras12/BVR-MP4_Converter</Hyperlink>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run FontWeight="SemiBold" Text="{local:Tr about_lic}"/>
                <Run Text="GNU General Public License v3.0 -"/>
                <Hyperlink NavigateUri="https://github.com/galandras12/BVR-MP4_Converter/blob/main/LICENSE" RequestNavigate="Link_Navigate">https://github.com/galandras12/BVR-MP4_Converter/blob/main/LICENSE</Hyperlink>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run FontWeight="SemiBold" Text="{local:Tr about_req}"/>
                <Run Text="ffmpeg, ffprobe"/>
            </TextBlock>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8">
                <Run FontWeight="SemiBold" Text="{local:Tr about_update}"/>
                <Hyperlink NavigateUri="https://github.com/galandras12/BVR-MP4_Converter/releases" RequestNavigate="Link_Navigate">https://github.com/galandras12/BVR-MP4_Converter/releases</Hyperlink>
            </TextBlock>
            <TextBlock Text="{local:Tr about_note}" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>

            <Button Content="{local:Tr btn_close}" IsDefault="True" IsCancel="True" HorizontalAlignment="Right"
                    Padding="18,4" Margin="0,16,0,0"/>
        </StackPanel>
    </Grid>
</Window>
